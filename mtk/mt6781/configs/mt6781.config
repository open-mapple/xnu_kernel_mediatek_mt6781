# Open Mapple fragment: the MediaTek MT6781 (Helio G96), whatever phone it is in. Laid over common_defconfig,
# which is the Qualcomm phone's: every Qualcomm and QEMU driver is left out.
#
# Four cores, as mtkloader starts them (its core_order): core 0 (an A55), then the two big cores 6 and 7, then A55s.
CONFIG_SOC="mt6781"
CONFIG_CPUS=4
# Qualcomm's: the storage, the touch screen and buttons on the PMIC, the Adreno, the DSPs, the modem, Wi-Fi, the chip's identity
# and sensors, the battery, the clocks
# CONFIG_UFS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_MAPPLE_GOODIX is not set
# CONFIG_MAPPLE_BUTTONS is not set
# CONFIG_MAPPLE_UFS is not set
# CONFIG_MAPPLE_ADRENO is not set
# CONFIG_MAPPLE_CAMERA is not set
# CONFIG_MAPPLE_TORCH is not set
# CONFIG_MAPPLE_HAPTIC is not set
# CONFIG_MAPPLE_ADSP is not set
# CONFIG_MAPPLE_SPEAKER is not set
# CONFIG_MAPPLE_SOUND is not set
# CONFIG_MAPPLE_MIC is not set
# CONFIG_MAPPLE_BATTERY is not set
# CONFIG_MAPPLE_CPUFREQ is not set
# CONFIG_MAPPLE_THERMAL is not set
# CONFIG_MAPPLE_PMIC is not set
# CONFIG_MAPPLE_BATTGUARD is not set
# CONFIG_MAPPLE_SOCINFO is not set
# CONFIG_MAPPLE_WIFI is not set
# CONFIG_MAPPLE_BT is not set
# CONFIG_MAPPLE_QMI is not set
# CONFIG_MAPPLE_MODEM is not set
# QEMU's
# CONFIG_MAPPLE_VIRTIO_INPUT is not set
# CONFIG_MAPPLE_VIRTIO_SOUND is not set
# CONFIG_MAPPLE_VIRTIO_NET is not set
# CONFIG_MAPPLE_VIRTIO_BLK is not set
# The MT6781's
CONFIG_MAPPLE_MT6781_KEYS=y
CONFIG_MAPPLE_MT6781_ILI=y
CONFIG_MAPPLE_MT6781_UFS=y
CONFIG_MAPPLE_MT6781_WDT=y
CONFIG_MAPPLE_MT6781_LVTS=y
CONFIG_MAPPLE_MT6781_DVFS=y
